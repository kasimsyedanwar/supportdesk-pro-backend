NODE_ENV=development
PORT=5000

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=supportdesk_pro
POSTGRES_USER=supportdesk_user
POSTGRES_PASSWORD=supportdesk_password
DATABASE_URL=postgresql://supportdesk_user:supportdesk_password@localhost:5432/supportdesk_pro?schema=public

REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379

MONGO_URL=mongodb://supportdesk_user:supportdesk_password@localhost:27017/supportdesk_pro_activity?authSource=admin
MONGO_DB_NAME=supportdesk_pro_activity

ACCESS_TOKEN_SECRET=replace_with_64_character_secret
ACCESS_TOKEN_EXPIRES_IN_SECONDS=900
REFRESH_TOKEN_EXPIRES_IN_DAYS=7

GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:5000/auth/google/callback
OAUTH_STATE_SECRET=replace_with_64_character_secret

UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_BYTES=5242880

AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=local
AWS_SECRET_ACCESS_KEY=local
AWS_S3_BUCKET=
S3_PRESIGNED_URL_EXPIRES_IN_SECONDS=300

AWS_DYNAMODB_ENDPOINT=http://127.0.0.1:8000
AWS_DYNAMODB_NOTIFICATION_EVENTS_TABLE=supportdesk_notification_events

CACHE_TTL_SECONDS=60
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=100