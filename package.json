{
  "name": "supportdesk-pro-backend",
  "version": "1.0.0",
  "description": "Professional TypeScript backend for role-based support ticket management.",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "prisma:format": "prisma format",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "db:seed": "prisma db seed",
    "dynamodb:create-table": "tsx src/scripts/create-dynamodb-table.ts",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:unit": "jest --testPathPatterns=unit",
    "test:integration": "jest --testPathPatterns=integration"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "keywords": [
    "typescript",
    "nodejs",
    "express",
    "backend",
    "supportdesk",
    "prisma",
    "postgresql",
    "redis",
    "jwt",
    "rbac"
  ],
  "author": "Kasim Syed Anwar",
  "license": "MIT",
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.1062.0",
    "@aws-sdk/client-s3": "^3.1062.0",
    "@aws-sdk/lib-dynamodb": "^3.1062.0",
    "@aws-sdk/s3-request-presigner": "^3.1062.0",
    "@prisma/client": "^6.19.3",
    "bcrypt": "^6.0.0",
    "dotenv": "^17.4.2",
    "express": "^4.18.0",
    "google-auth-library": "^10.6.2",
    "ioredis": "^5.11.1",
    "jsonwebtoken": "^9.0.3",
    "mongodb": "^7.2.0",
    "multer": "^2.1.1",
    "pg": "^8.21.0",
    "pino": "^10.3.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@jest/globals": "^30.4.1",
    "@types/bcrypt": "^6.0.0",
    "@types/express": "^4.17.0",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.1.0",
    "@types/node": "^20.0.0",
    "@types/pg": "^8.20.0",
    "@types/supertest": "^7.2.0",
    "jest": "^30.4.2",
    "pino-pretty": "^13.1.3",
    "prisma": "^6.19.3",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.11",
    "tsx": "^4.22.4",
    "typescript": "^5.0.0"
  }
}
